# Скопіюйте цей файл у ".env" і заповніть власними значеннями.
# Файл .env НІКОЛИ не публікуйте і не завантажуйте в публічний GitHub-репозиторій.

# Токен бота, який видає @BotFather
TELEGRAM_BOT_TOKEN=

# ID або @username каналу, куди бот публікуватиме дайджест
# (бот має бути доданий у канал як адміністратор)
TELEGRAM_CHANNEL_ID=

# Ключ Anthropic API (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Необов'язково, але бажано: ключ NCBI/PubMed для вищих лімітів запитів
# Отримати: https://www.ncbi.nlm.nih.gov/account/settings/ -> API Key Management
NCBI_API_KEY=

# Як часто перевіряти нові статті (у годинах)
CHECK_INTERVAL_HOURS=12

# Скільки днів "назад" шукати нові публікації при кожній перевірці
LOOKBACK_DAYS=14

# Максимум статей на тему за один прохід
MAX_ARTICLES_PER_TOPIC=5
