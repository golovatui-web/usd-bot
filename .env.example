# Скопіюйте цей файл у ".env" і заповніть власними значеннями.
# Файл .env НІКОЛИ не публікуйте і не завантажуйте в публічний GitHub-репозиторій.

# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=

# ID або @username каналу (бот має бути адміністратором каналу)
TELEGRAM_CHANNEL_ID=

# Ключ Gemini API — БЕЗКОШТОВНИЙ тариф Google AI Studio
# Отримати: https://aistudio.google.com/apikey
# Замінює колишній ANTHROPIC_API_KEY.
GEMINI_API_KEY=

# Необов'язково: NCBI/PubMed ключ для вищих лімітів
# https://www.ncbi.nlm.nih.gov/account/settings/ -> API Key Management
NCBI_API_KEY=

# О котрій годині щодня (за київським часом) публікувати дайджест. 0-23.
DIGEST_HOUR_KYIV=8

# Скільки днів "назад" шукати нові публікації. З запасом (5, не 1-2),
# щоб не втратити статті після простою сервера. Повторні PMID відсіюються
# до виклику Gemini.
LOOKBACK_DAYS=5

# Максимум статей на ОДНУ тему за один прохід фідера.
MAX_ARTICLES_PER_TOPIC=3

# Жорсткий ліміт: максимум статей СУМАРНО, які воркер опрацює Gemini за добу.
# Запобіжник безкоштовної квоти (Flash ~250 RPD, Pro ~50-100 RPD — залежить
# від проєкту в AI Studio).
MAX_ARTICLES_PER_DAY=40

# Необов'язково: ваш Telegram ID. Після дайджесту бот напише
# "Живий. Оброблено сьогодні: N. Черга pending: X, failed: Y."
ADMIN_CHAT_ID=

# ---- Gemini: моделі та 24/7 pacing ------------------------------------------------

# Tier 1 — кожна стаття. Безкоштовний Flash.
SUMMARIZER_FAST_MODEL=gemini-2.5-flash

# Tier 2 — лише High/Medium practical_relevance. Тісніша квота.
SUMMARIZER_PREMIUM_MODEL=gemini-2.5-pro

# false = лише Flash для всіх статей (якщо Pro-квота кінчилась / не потрібна).
ENABLE_PREMIUM_UPGRADE=true

# Головний критерій апгрейду на Pro. High,Medium = усе, крім суто дослідницьких.
UPGRADE_PRACTICAL_LEVELS=High,Medium

# Додатковий критерій за дизайном дослідження. Порожньо = вимкнено.
UPGRADE_EVIDENCE_LEVELS=

# Максимум Pro-викликів на добу (окремо від MAX_ARTICLES_PER_DAY).
MAX_PREMIUM_PER_DAY=40

# Обов'язкова пауза між БУДЬ-ЯКИМИ викликами Gemini, секунди.
# 6 с ≈ 10 RPM, нижче типових 10-15 RPM безкоштовного Flash і 5 RPM Pro.
GEMINI_CALL_GAP_SECONDS=6

# Фідер: скільки тем за один тік і як часто (хвилини). 3 теми / 15 хв
# → повне коло 25 тем ≈ 2 год, кілька кіл на добу.
FEED_TOPICS_PER_TICK=3
FEED_INTERVAL_MINUTES=15

# Воркер: інтервал між спробами взяти 1 статтю з черги, секунди.
# Разом із GEMINI_CALL_GAP_SECONDS тримає RPM у межах free-tier.
WORKER_INTERVAL_SECONDS=15

# Скільки разів воркер повторює статтю перед статусом failed (без публікації).
MAX_QUEUE_ATTEMPTS=3
